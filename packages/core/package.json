{
  "name": "@define/core",
  "version": "0.1.0",
  "description": "Core DSL and metadata model for Define.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "define",
    "dsl",
    "typescript",
    "codegen"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "pnpm build && tsd --files test/types/**/*.test-d.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsd": "^0.31.2",
    "vitest": "^3.0.7"
  }
}
