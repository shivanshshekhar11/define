{
  "name": "@define/adapter-drizzle",
  "version": "0.1.0",
  "description": "Drizzle schema and repository generator for Define.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "define",
    "drizzle",
    "orm",
    "codegen"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@define/core": "workspace:*",
    "drizzle-orm": "^0.44.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^3.0.7"
  }
}
